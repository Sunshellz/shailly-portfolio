---
import Layout from '../../../../layouts/Layout.astro';
---

<Layout title="Volunteer Agreement \u2014 Shailly | Organisational Documentation" description="A sample organisational document formalising volunteer expectations, responsibilities, supervision, confidentiality, and terms of engagement. Full document attached." path="/work/samples/volunteer-agreement/" ogType="article" ogTitle="Volunteer Agreement \u2014 Shailly">
  <article>
    <header class="case-hero">
      <div class="wrap">
        <nav class="breadcrumb mono" aria-label="Breadcrumb">
          <a href="/">Home</a><span class="sep" aria-hidden="true">/</span>
          <a href="/work/">Selected Work</a><span class="sep" aria-hidden="true">/</span>
          <span>Volunteer Agreement</span>
        </nav>

        <div class="page-head-grid">
          <div>
            <p class="mono case-cat">Organisational documentation</p>
            <h1>Volunteer Agreement</h1>
            <p class="sample-sub">A sample organisational document developed to formalise volunteer expectations, responsibilities, supervision, confidentiality, and other terms of engagement.</p>
          </div>
          <div class="head-fact reveal">
            <span class="mono">Document</span>
            <dl>
              <dt class="mono">Type</dt>
              <dd>Sample organisational document</dd>
              <dt class="mono">Purpose</dt>
              <dd>Formalise the terms of volunteer engagement</dd>
              <dt class="mono">Status</dt>
              <dd>Full document (PDF)</dd>
            </dl>
          </div>
        </div>
      </div>
    </header>

    <section class="cs-section">
      <div class="wrap cs-grid">
        <div class="cs-label"><span class="n">01</span><h2>The document</h2></div>
        <div class="cs-body">
          <p class="lead">Created to give volunteers and the organisation a shared, written understanding of the relationship.</p>

          <div class="doc-preview">
            <object class="doc-frame" data="/documents/volunteer-agreement.pdf" type="application/pdf" title="Volunteer Agreement — full document (PDF)">
              <p>The PDF can&rsquo;t be displayed inline here. <a href="/documents/volunteer-agreement.pdf" target="_blank" rel="noopener">Open it directly <span aria-hidden="true">&nearr;</span></a></p>
            </object>
            <p class="tracker-note"><span class="mark" aria-hidden="true">&#9656;</span> <a href="/documents/volunteer-agreement.pdf" target="_blank" rel="noopener">Open or download the full document (PDF) <span aria-hidden="true">&nearr;</span></a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-section">
      <div class="wrap cs-grid">
        <div class="cs-label"><span class="n">02</span><h2>What it formalises</h2></div>
        <div class="cs-body">
          <div class="artefacts">
            <div class="artefact-grid">
              <div class="artefact"><span class="mono">01</span>Volunteer expectations and responsibilities</div>
              <div class="artefact"><span class="mono">02</span>Supervision and reporting lines</div>
              <div class="artefact"><span class="mono">03</span>Confidentiality</div>
              <div class="artefact"><span class="mono">04</span>Other terms of engagement</div>
            </div>
          </div>
          <p style="margin-top:1.4rem">The document formed part of the organisational systems built alongside policies, codes of conduct, MOAs, and process documentation.</p>
        </div>
      </div>
    </section>

    <div class="wrap">
      <nav class="next-project" aria-label="Next document">
        <div>
          <span class="mono np-label">Next / Document 02</span>
          <a href="/work/samples/memorandum-of-agreement/"><span class="np-title">Memorandum of Agreement &rarr;</span></a>
        </div>
        <a class="link-arrow" href="/work/">All selected work <span aria-hidden="true">&nearr;</span></a>
      </nav>
    </div>
  </article>
</Layout>
