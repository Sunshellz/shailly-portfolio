---
import Layout from '../../../../layouts/Layout.astro';
---

<Layout title="Memorandum of Agreement \u2014 Shailly | Organisational Documentation" description="A sample collaboration document covering scope, responsibilities, terms, funding arrangements, and formal agreement between parties. Full document attached." path="/work/samples/memorandum-of-agreement/" ogType="article" ogTitle="Memorandum of Agreement \u2014 Shailly">
  <article>
    <header class="case-hero">
      <div class="wrap">
        <nav class="breadcrumb mono" aria-label="Breadcrumb">
          <a href="/">Home</a><span class="sep" aria-hidden="true">/</span>
          <a href="/work/">Selected Work</a><span class="sep" aria-hidden="true">/</span>
          <span>Memorandum of Agreement</span>
        </nav>

        <div class="page-head-grid">
          <div>
            <p class="mono case-cat">Organisational documentation</p>
            <h1>Memorandum of Agreement</h1>
            <p class="sample-sub">A sample collaboration document covering scope, responsibilities, terms, funding arrangements, and formal agreement between parties.</p>
          </div>
          <div class="head-fact reveal">
            <span class="mono">Document</span>
            <dl>
              <dt class="mono">Type</dt>
              <dd>Sample organisational document</dd>
              <dt class="mono">Purpose</dt>
              <dd>Formalise a collaboration between parties</dd>
              <dt class="mono">Status</dt>
              <dd>Full document (PDF)</dd>
            </dl>
          </div>
        </div>
      </div>
    </header>

    <section class="cs-section">
      <div class="wrap cs-grid">
        <div class="cs-label"><span class="n">01</span><h2>The document</h2></div>
        <div class="cs-body">
          <p class="lead">A memorandum of agreement sets out what two organisations are doing together, and on what terms.</p>

          <div class="doc-preview">
            <object class="doc-frame" data="/documents/memorandum-of-agreement.pdf" type="application/pdf" title="Memorandum of Agreement — full document (PDF)">
              <p>The PDF can&rsquo;t be displayed inline here. <a href="/documents/memorandum-of-agreement.pdf" target="_blank" rel="noopener">Open it directly <span aria-hidden="true">&nearr;</span></a></p>
            </object>
            <p class="tracker-note"><span class="mark" aria-hidden="true">&#9656;</span> <a href="/documents/memorandum-of-agreement.pdf" target="_blank" rel="noopener">Open or download the full document (PDF) <span aria-hidden="true">&nearr;</span></a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-section">
      <div class="wrap cs-grid">
        <div class="cs-label"><span class="n">02</span><h2>What it covers</h2></div>
        <div class="cs-body">
          <div class="artefacts">
            <div class="artefact-grid">
              <div class="artefact"><span class="mono">01</span>Scope of the collaboration</div>
              <div class="artefact"><span class="mono">02</span>Responsibilities of each party</div>
              <div class="artefact"><span class="mono">03</span>Terms</div>
              <div class="artefact"><span class="mono">04</span>Funding arrangements</div>
              <div class="artefact"><span class="mono">05</span>Formal agreement</div>
            </div>
          </div>
          <p style="margin-top:1.4rem">Part of the documentation set created to make collaborations explicit rather than assumed &mdash; so responsibilities and terms are visible to everyone involved.</p>
        </div>
      </div>
    </section>

    <div class="wrap">
      <nav class="next-project" aria-label="Back to work index">
        <div>
          <span class="mono np-label">Back to</span>
          <a href="/work/"><span class="np-title">Selected Work &rarr;</span></a>
        </div>
        <a class="link-arrow" href="/work/samples/kraftshala-assignment/">Strongest work sample <span aria-hidden="true">&nearr;</span></a>
      </nav>
    </div>
  </article>
</Layout>
